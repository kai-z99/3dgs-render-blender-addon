import bpy
import os
import math
from mathutils import Vector

# =========================
# ==== DEBUG CONTROLS  ====
# =========================
DEBUG = False
PRINT_SAVE_CHECKS = True
KEEP_STRIPS = DEBUG  # Delete strips after stitching unless debugging

def dbg(msg):
    if DEBUG:
        print(f"[EQSTRIP] {msg}", flush=True)

# =========================
# ======   SETTINGS   =====
# =========================
# Geometry / tiling
NUM_STRIPS      = 8            # 1 = full 360 in one shot; N strips each 360/N degrees
HEIGHT          = 1024         # pixel height of each strip (equirect full vertical FOV)

# I/O and render format
OUTPUT_DIR     = "//eq_strips/"   # relative to .blend unless absolute path
FILE_FMT       = 'PNG'            # 'PNG' (LDR), 'OPEN_EXR' (HDR), or 'HDR' (Radiance)
VIEW_TRANSFORM = 'Standard'       # 'Standard' for LDR, 'Raw' for scene-linear workflows
ENGINE         = 'CYCLES'         # !!! Must be CYCLES for panoramic equirect !!!

# =========================
# ======  CONSTANTS   =====
# =========================
EXT_MAP = {
    'PNG': '.png', 'OPEN_EXR': '.exr', 'HDR': '.hdr', 'JPEG': '.jpg',
    'TIFF': '.tif','TARGA': '.tga','TARGA_RAW': '.tga'
}
EXT = EXT_MAP.get(FILE_FMT, '.png')
IS_HDRLIKE = FILE_FMT in {'OPEN_EXR','HDR'}
IS_EXR     = FILE_FMT == 'OPEN_EXR'
IS_RAD_HDR = FILE_FMT == 'HDR'
COLORSPACE = 'Linear' if IS_HDRLIKE else 'sRGB'


# Ensure output dir exists
abs_out = bpy.path.abspath(OUTPUT_DIR)
os.makedirs(abs_out, exist_ok=True)

# Scene/render setup
scene = bpy.context.scene

# Ensure a camera exists (prefer the active scene camera), keep its CURRENT LOCATION
cam = scene.camera if scene.camera and scene.camera.type == 'CAMERA' else None
if cam is None:
    for obj in bpy.data.objects:
        if obj.type == 'CAMERA':
            cam = obj
            break
if cam is None:
    cam_data = bpy.data.cameras.new("EquirectCam")
    cam = bpy.data.objects.new("EquirectCam", cam_data)
    bpy.context.collection.objects.link(cam)
    dbg("Created camera: EquirectCam")
else:
    dbg(f"Using existing camera at location: {tuple(cam.location)}")

# Do NOT move the camera; use its current location
scene.camera = cam

# Configure as panoramic equirectangular (Cycles only)
cam.data.type = 'PANO'
cam.data.panorama_type = 'EQUIRECTANGULAR'

scene.render.engine = ENGINE

# Final pano must be exactly 2:1; set total width accordingly.
BASE_W = int(2 * HEIGHT)  # final stitched width
scene.render.resolution_x = BASE_W
scene.render.resolution_y = HEIGHT
scene.render.resolution_percentage = 100

scene.render.image_settings.file_format = FILE_FMT
scene.render.image_settings.color_mode = 'RGB' if IS_RAD_HDR else 'RGBA'
try:
    scene.view_settings.view_transform = VIEW_TRANSFORM
except Exception:
    pass
scene.render.use_file_extension = True
scene.render.use_overwrite = True
scene.render.film_transparent = False

# Crop/border render to produce vertical strips
scene.render.use_border = True
scene.render.use_crop_to_border = True  # output size == cropped area

# HDR specifics
if IS_EXR:
    scene.render.image_settings.color_depth = '32'
    scene.render.image_settings.exr_codec = 'ZIP'
elif IS_RAD_HDR:
    scene.render.image_settings.color_depth = '32'  # Radiance HDR is RGB-only

# Helpers
def set_yaw_deg(z_degrees: float):
    # Keep X/Y (pitch/roll) set for level horizon; yaw around Z
    cam.rotation_euler[0] = math.radians(90)
    cam.rotation_euler[1] = math.radians(0)
    cam.rotation_euler[2] = math.radians(z_degrees)

def set_border(min_x: float, max_x: float):
    # min/max in [0,1] across the full equirectangular width
    scene.render.border_min_x = min_x
    scene.render.border_max_x = max_x
    scene.render.border_min_y = 0.0
    scene.render.border_max_y = 1.0

def pixel_edges(total_w: int, n: int):
    """Return integer pixel edges [e0..en] that partition total_w into n strips
    whose widths differ by at most 1 px and sum exactly to total_w."""
    edges = [(i * total_w) // n for i in range(n + 1)]
    return edges

# Log base
dbg(f"START | strips={NUM_STRIPS} height={HEIGHT} -> pano={BASE_W}x{HEIGHT} (2:1) engine={ENGINE} fmt={FILE_FMT} view={VIEW_TRANSFORM}")
dbg(f"HDRLIKE={IS_HDRLIKE} EXR={IS_EXR} RAD_HDR={IS_RAD_HDR} COLORSPACE={COLORSPACE} EXT={EXT}")

# Precompute exact pixel edges and per-strip widths
edges_px = pixel_edges(BASE_W, NUM_STRIPS)
widths_px = [edges_px[i+1] - edges_px[i] for i in range(NUM_STRIPS)]
dbg(f"Per-strip widths (px): {widths_px} (sum={sum(widths_px)})")

# --- Pre-run cleanup: remove any leftover strips from previous runs ---
import glob as _glob
_prev_patterns = [os.path.join(abs_out, f"strip_*{ext}") for ext in [".png", ".jpg", ".jpeg", ".tif", ".tiff", ".tga", ".hdr", ".exr"]]
_prev_deleted = 0
for _pat in _glob.glob(os.path.join(abs_out, "strip_*")):
    # Broad match to catch all extensions, then filter by known ones
    if any(_pat.lower().endswith(ext) for ext in [".png", ".jpg", ".jpeg", ".tif", ".tiff", ".tga", ".hdr", ".exr"]):
        try:
            os.remove(_pat)
            _prev_deleted += 1
        except Exception as e:
            dbg(f"Could not delete old strip {_pat}: {e}")
if _prev_deleted:
    dbg(f"Pre-clean: removed {_prev_deleted} old strip file(s).")

# Render N strips
for i in range(NUM_STRIPS):
    # Rotate Z by i * 360/N; render the leftmost band with exact pixel width
    set_yaw_deg(i * (360.0 / NUM_STRIPS))
    w_px = widths_px[i]
    min_x = 0.0
    max_x = w_px / BASE_W
    set_border(min_x, max_x)

    base_name = f"strip_{i:03d}"
    scene.render.filepath = OUTPUT_DIR + base_name
    bpy.ops.render.render(write_still=True)
    #bpy.ops.sna.dgs_render_advanced_render_ba196()
    out_path = os.path.join(abs_out, base_name + EXT)

    size = -1
    try:
        size = os.path.getsize(out_path)
    except Exception:
        pass
    if PRINT_SAVE_CHECKS:
        dbg(f"Rendered {base_name} -> {bpy.path.abspath(out_path)} (bytes={size})")

print("Equirectangular strips written to:", abs_out)
dbg("DONE.")

# =========================
# ===== Stitch Phase  =====
# =========================
# To preserve the exact logic of the standalone stitching script without modification,
# we write its original source to a temporary Python file and invoke it as a
# subprocess using Blender's bundled Python. This avoids any changes to argparse
# behavior or runtime flow in the stitcher itself.

import sys
import subprocess
import tempfile
import importlib.util

# --- Dependency handling (simple & reliable) ---

def _has_module(mod):
    return importlib.util.find_spec(mod) is not None


def _ensure_packages(pkgs, target_dir):
    """
    Ensure each (import_name, pip_name_or_None) is importable.
    Try: user install -> target install (target_dir) and expose it to parent + child.
    Returns an env dict to pass to subprocess.run(..., env=env).
    """
    env = os.environ.copy()

    # Determine which are missing
    need = []
    for imp, pipname in pkgs:
        name = pipname or imp
        if not _has_module(imp):
            need.append((imp, name))

    if not need:
        return env  # everything already available

    # Make sure pip exists; keep this non-fatal
    subprocess.run([sys.executable, "-m", "ensurepip", "--upgrade"], check=False)
    subprocess.run([sys.executable, "-m", "pip", "install", "--upgrade", "pip", "setuptools", "wheel"], check=False)

    # 1) Try user site (no admin required)
    for imp, name in need:
        subprocess.run([sys.executable, "-m", "pip", "install", "--user", name], check=False)

    # Re-check which still missing
    still = []
    for imp, name in need:
        if not _has_module(imp):
            still.append((imp, name))

    if not still:
        return env

    # 2) Fallback to project-local target
    os.makedirs(target_dir, exist_ok=True)
    for imp, name in still:
        subprocess.run(
            [sys.executable, "-m", "pip", "install", "--no-warn-script-location", "--target", target_dir, name],
            check=False
        )

    # Make sure the parent can import from target_dir now
    if target_dir not in sys.path:
        sys.path.insert(0, target_dir)

    # Ensure the child process (stitcher) can also see target_dir
    env["PYTHONPATH"] = target_dir + (os.pathsep + env.get("PYTHONPATH", "") if env.get("PYTHONPATH") else "")
    return env

# Ensure the packages based on render format (keeping your functionality)
pydeps_dir = os.path.join(abs_out, "_pydeps")
child_env = _ensure_packages([
    ("PIL", "Pillow"),     # for PNG/JPG/TIFF/TGA
    ("imageio", "imageio") # for HDR/EXR
], pydeps_dir)

#Gonna run this on its own because originally this was a seperate python file and the behavior might change if we try to directly translate in blender.
#But we should change this later.
STITCHER_CODE = r'''#!/usr/bin/env python3
import os, re, sys, argparse
import numpy as np

# Try imageio for HDR/EXR; Pillow for the rest
try:
    import imageio.v3 as iio
except Exception:
    iio = None
try:
    from PIL import Image
except Exception:
    Image = None

SUPPORTED_EXTS = [".png", ".jpg", ".jpeg", ".tif", ".tiff", ".tga", ".hdr", ".exr"]
_num_re = re.compile(r"(\d+)")

def _read(path: str):
    ext = os.path.splitext(path)[1].lower()
    if ext in (".hdr", ".exr"):
        if iio is None:
            raise RuntimeError("Reading HDR/EXR requires imageio (pip install imageio).")
        arr = iio.imread(path)
        if arr.ndim == 2:  # grayscale -> RGB
            arr = np.stack([arr, arr, arr], axis=-1)
        return arr
    else:
        if Image is None:
            raise RuntimeError("Reading PNG/JPG/TIFF/TGA requires Pillow (pip install Pillow).")
        with Image.open(path) as im:
            # Preserve alpha if present
            if im.mode not in ("RGB", "RGBA"):
                im = im.convert("RGBA" if "A" in im.getbands() else "RGB")
            return np.array(im)

def _write(path: str, arr):
    ext = os.path.splitext(path)[1].lower()
    if ext == ".hdr" and arr.ndim == 3 and arr.shape[-1] == 4:
        arr = arr[..., :3]  # Radiance HDR is RGB-only
    if ext in (".hdr", ".exr"):
        if iio is None:
            raise RuntimeError("Writing HDR/EXR requires imageio (pip install imageio).")
        iio.imwrite(path, arr.astype(np.float32))
        return
    if Image is None:
        raise RuntimeError("Writing PNG/JPG/TIFF/TGA requires Pillow.")
    a = arr
    if a.ndim == 2:
        a = np.stack([a, a, a], axis=-1)
    if a.dtype.kind == 'f':
        mx = float(np.nanmax(a)) if a.size else 0.0
        mn = float(np.nanmin(a)) if a.size else 0.0
        if mx > 1.5 or mn < -0.5:
            a = np.clip(a, 0.0, 255.0).astype('uint8')
        else:
            a = (np.clip(a, 0.0, 1.0) * 255.0 + 0.5).astype('uint8')
    elif a.dtype != np.uint8:
        a = np.clip(a, 0, 255).astype('uint8')
    Image.fromarray(a).save(path)

def _find_strips(folder: str, pattern_prefix="strip_"):
    """Collect strips in numeric order; prefer names like strip_###.ext,
    else fall back to any supported ext and sort by first integer in name."""
    entries = []
    for name in os.listdir(folder):
        low = name.lower()
        root, ext = os.path.splitext(low)
        if ext in SUPPORTED_EXTS and root.startswith(pattern_prefix):
            entries.append(name)
    if not entries:
        entries = [n for n in os.listdir(folder)
                   if os.path.splitext(n.lower())[1] in SUPPORTED_EXTS]
    if not entries:
        raise FileNotFoundError("No strips found.")

    def key(nm):
        m = _num_re.search(nm)
        return int(m.group(1)) if m else 0

    entries.sort(key=key, reverse=True)
    return [os.path.join(folder, n) for n in entries]

def _unify_dtype_and_channels(imgs):
    # Match channel count across images; prefer RGBA if any has alpha
    max_c = max((im.shape[2] if im.ndim == 3 else 1) for im in imgs)
    want_c = 4 if max_c == 4 else 3
    out = []
    for im in imgs:
        if im.ndim == 2:
            im = np.stack([im, im, im], axis=-1)
        c = im.shape[2]
        if c == want_c:
            out.append(im)
        elif c == 3 and want_c == 4:
            a = np.full(im.shape[:2] + (1,), 255 if im.dtype == np.uint8 else 1.0, dtype=im.dtype)
            out.append(np.concatenate([im, a], axis=-1))
        elif c == 4 and want_c == 3:
            out.append(im[..., :3])
        else:
            out.append(im)
    return out

def main():
    ap = argparse.ArgumentParser(description="Stitch vertical equirectangular strips captured in order.")
    ap.add_argument("--folder", "-f", default=".", help="Folder containing strip_### files")
    ap.add_argument("--prefix", default="strip_", help="Filename prefix (default strip_)")
    ap.add_argument("--out", "-o", default="equirect", help="Output base name (no extension)")
    ap.add_argument("--ext", default=None, help="Override output extension, e.g. .png/.exr/.hdr")
    ap.add_argument("--expected", type=int, default=None, help="Optional: expected number of strips")
    args = ap.parse_args()

    folder = os.path.abspath(args.folder)
    paths = _find_strips(folder, pattern_prefix=args.prefix)

    if args.expected is not None and len(paths) != args.expected:
        print(f"[WARN] Found {len(paths)} strips, expected {args.expected}.")

    # Read and standardize
    imgs = [_read(p) for p in paths]
    imgs = _unify_dtype_and_channels(imgs)

    # Equalize height to the smallest (guards against 1px mismatches)
    min_h = min(im.shape[0] for im in imgs)
    imgs = [im[:min_h, :im.shape[1], ...] for im in imgs]

    # Concatenate left→right in numeric order
    ch = imgs[0].shape[2] if imgs[0].ndim == 3 else 1
    total_w = sum(im.shape[1] for im in imgs)
    dtype = imgs[0].dtype
    pano = np.zeros((min_h, total_w, ch), dtype=dtype)
    x = 0
    for im in imgs:
        w = im.shape[1]
        pano[:, x:x+w, ...] = im
        x += w

    # Choose extension (default to first strip's)
    in_ext = os.path.splitext(paths[0])[1]
    out_ext = args.ext if args.ext else in_ext
    if not out_ext.startswith('.'):
        out_ext = '.' + out_ext

    out_path = os.path.join(folder, args.out + out_ext)
    _write(out_path, pano)

    print(f"Saved equirectangular panorama: {out_path}")
    print(f"Final size: {total_w}x{min_h}  |  strips: {len(imgs)}")
    print(f"Order used: {paths}")

if __name__ == "__main__":
    main()
'''

# Write the stitcher to a temp file
with tempfile.NamedTemporaryFile('w', delete=False, suffix='_stitch_eq_strips.py', dir=abs_out) as tf:
    tf.write(STITCHER_CODE)
    stitcher_path = tf.name

# Invoke the stitcher with the strips folder and expected count
cmd = [sys.executable, stitcher_path, '--folder', abs_out, '--prefix', 'strip_', '--expected', str(NUM_STRIPS)]
print('[EQSTRIP] Running stitcher:', ' '.join(cmd))
try:
    # Let the stitcher print its own progress/errors; do not alter its logic
    result = subprocess.run(cmd, check=False, env=child_env)
finally:
    # Optional cleanup: comment out the next line if you want to keep the temp stitcher file
    try:
        os.remove(stitcher_path)
    except Exception:
        pass

# --- Post-stitch cleanup of intermediate strips ---
rc = result.returncode if 'result' in locals() else -1
if rc == 0 and not KEEP_STRIPS:
    import glob
    patterns = [os.path.join(abs_out, f"strip_*{ext}") for ext in [".png", ".jpg", ".jpeg", ".tif", ".tiff", ".tga", ".hdr", ".exr"]]
    deleted = 0
    for pat in patterns:
        for p in glob.glob(pat):
            try:
                os.remove(p)
                deleted += 1
                dbg(f"Deleted strip: {os.path.basename(p)}")
            except Exception as e:
                dbg(f"Could not delete {p}: {e}")
    dbg(f"Cleanup complete. Removed {deleted} strip file(s).")
else:
    if rc != 0:
        dbg("Stitcher failed; keeping strips for debugging.")
    elif KEEP_STRIPS:
        dbg("KEEP_STRIPS is True; keeping intermediate strips.")