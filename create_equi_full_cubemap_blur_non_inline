def _has_module(mod_name):
    return importlib.util.find_spec(mod_name) is not None

def _ensure_packages(pkgs, target_dir):
    """
    pkgs: list of (import_name, pip_name_or_None)
    Tries user install first, then a local target folder.
    """
    need = []
    for imp_name, pip_name in pkgs:
        name = pip_name or imp_name
        if not _has_module(imp_name):
            need.append((imp_name, name))

    if not need:
        return

    # Make sure pip exists for this Python
    subprocess.run([sys.executable, "-m", "ensurepip", "--upgrade"], check=False)
    subprocess.run([sys.executable, "-m", "pip", "install",
                    "--upgrade", "pip", "setuptools", "wheel"], check=False)

    # 1) Try user install
    for imp_name, pip_pkg in need:
        subprocess.run([sys.executable, "-m", "pip", "install", "--user", pip_pkg],
                       check=False)

    # Re-check
    still = []
    for imp_name, pip_pkg in need:
        if not _has_module(imp_name):
            still.append((imp_name, pip_pkg))

    if not still:
        return

    # 2) Fallback: install into a project-local folder
    os.makedirs(target_dir, exist_ok=True)
    for imp_name, pip_pkg in still:
        subprocess.run(
            [sys.executable, "-m", "pip", "install",
             "--no-warn-script-location",
             "--target", target_dir, pip_pkg],
            check=False
        )

    if target_dir not in sys.path:
        sys.path.insert(0, target_dir)

_pydeps_dir = os.path.join(abs_out, "_pydeps")
_ensure_packages([
